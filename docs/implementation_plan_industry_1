```python
"""
MGPS (Multi-item Gamma Poisson Shrinker) — FDA's primary signal detection algorithm.
Implements the DuMouchel (1999) empirical Bayes model.

EBGM = E[lambda | data] where lambda ~ Gamma(alpha, beta)
EB05 = 5th percentile (conservative lower bound — used for regulatory reporting)
EB95 = 95th percentile (optimistic upper bound)

A signal is considered when EB05 > 2.0 (stronger evidence than PRR > 2.0).
"""

def fit_prior(contingency_table: pd.DataFrame) -> tuple[float, float, float, float]:
    """Fit mixture Gamma prior parameters (alpha1, beta1, alpha2, beta2) via EM."""

def compute_ebgm(a, n_drug, n_event, N_total, prior_params) -> dict:
    """
    Returns {'ebgm': float, 'eb05': float, 'eb95': float, 'expected': float}
    expected = (n_drug * n_event) / N_total  (independence assumption baseline)
    """

def batch_compute_mgps(drug_event_pairs: list, duckdb_conn) -> pd.DataFrame:
    """
    Vectorized MGPS over a list of (drug, event) pairs using DuckDB counts.
    Returns DataFrame with EBGM, EB05, EB95 columns.
    """
```

