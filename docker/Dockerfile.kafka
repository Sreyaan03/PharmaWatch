# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.kafka — Lightweight image for Kafka producer & consumer
# Used by kafka-producer and kafka-consumer services in compose.yml (kafka profile)
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

WORKDIR /app

# Producer and consumer dependencies. DuckDB reads the identity tables (evidence linking,
# loaded quarters); pyarrow is needed when the consumer runs a FAERS refresh job.
RUN pip install --no-cache-dir \
    "kafka-python>=2.0.2" \
    "requests>=2.31.0" \
    "feedparser>=6.0.11" \
    "python-dotenv>=1.0.1" \
    "numpy>=1.26.4,<2.0.0" \
    "PyMySQL>=1.1.1" \
    "cryptography>=42.0.8" \
    "DBUtils>=3.1.0" \
    "duckdb==1.5.3" \
    "pyarrow==24.0.0"

# Copy backend modules (excluding secrets via .dockerignore)
COPY backend/ ./backend/

ENV PYTHONPATH=/app:/app/backend \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
