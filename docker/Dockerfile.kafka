# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.kafka — Lightweight image for Kafka producer & consumer
# Used by kafka-producer and kafka-consumer services in docker-compose.yml
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

WORKDIR /app

# Install dependencies required by producer, consumer, and metrics calculation
RUN pip install --no-cache-dir \
    "kafka-python>=2.0.2" \
    "requests>=2.31.0" \
    "feedparser>=6.0.11" \
    "python-dotenv>=1.0.1" \
    "numpy>=1.26.4,<2.0.0" \
    "PyMySQL>=1.1.1" \
    "cryptography>=42.0.8" \
    "DBUtils>=3.1.0"

# Copy backend modules (excluding secrets via .dockerignore)
COPY backend/ ./backend/

ENV PYTHONPATH=/app:/app/backend \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
