# PharmaWatch settings. Generated from backend/core/config.py by `python -m core.config`;
# edit that file, not this one. Copy to backend/.env and fill in what you need.

# ── app ──
# Interface the development server listens on
HOST=0.0.0.0
# Port the development server listens on
PORT=5000
# Comma-separated origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# Key for admin endpoints (X-Admin-Key header); empty disables them
ADMIN_API_KEY=
# Signs the session cookie; required when AUTH_REQUIRED is on
FLASK_SECRET_KEY=
# Require sign-in and enforce roles; off keeps single-user local development open
AUTH_REQUIRED=false
# Large data (FAERS database, raw files, caches); empty means <repo>/data
DATA_DIR=
# Where rate-limit counters live: memory:// on one machine, redis://host:6379 when several web copies share the limit
RATE_LIMIT_STORAGE_URI=memory://

# ── mysql ──
# MySQL host
MYSQL_HOST=localhost
# MySQL port
MYSQL_PORT=3306
# MySQL user
MYSQL_USER=root
# MySQL password
MYSQL_PASSWORD=
# MySQL database name
MYSQL_DATABASE=pharmawatch
# Connection pool size per process
MYSQL_MAX_CONNECTIONS=20
# Idle connections kept open per process
MYSQL_MIN_CACHED=2
# Most idle connections kept per process
MYSQL_MAX_CACHED=10

# ── bigdata ──
# Kafka brokers, comma-separated
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# HBase Thrift server host
HBASE_HOST=127.0.0.1
# HBase Thrift server port
HBASE_PORT=9090
# Spark master: local[*] on one machine, spark://host:7077 for a cluster
SPARK_MASTER=local[*]
# Load a newly announced FAERS quarter without waiting for an admin
FAERS_AUTO_REFRESH=false

# ── storage ──
# local (DATA_DIR) or s3 (any S3-compatible store: MinIO, S3, ...)
STORAGE_BACKEND=local
# S3 endpoint; empty for AWS, e.g. http://minio:9000 for MinIO
S3_ENDPOINT_URL=
# Bucket holding every storage area
S3_BUCKET=pharmawatch
# S3 region
S3_REGION=us-east-1
# S3 access key
S3_ACCESS_KEY_ID=
# S3 secret key
S3_SECRET_ACCESS_KEY=
# Local copies of stored files (models); empty means DATA_DIR/cache
STORAGE_CACHE_DIR=

# ── jobs ──
# inline (threads in the web process) or kafka (separate worker processes)
QUEUE_MODE=inline
# Threads per process that run jobs
JOB_THREADS=2
# How long a running job is held without a heartbeat before another worker may take it
JOB_LEASE_SECONDS=120
# Partitions per job topic: the most workers that can share one kind of job
JOB_TOPIC_PARTITIONS=6
# CPU threads per worker for OCR and models; 0 = one per core. With several workers on one machine use cores / workers
TORCH_THREADS=0

# ── external ──
# openFDA API key
FDA_API_KEY=
# NCBI E-utilities API key
NCBI_API_KEY=
# Enables the optional cloud prescription extractor
ANTHROPIC_API_KEY=
# Prescription extractor: auto, local or cloud
RX_EXTRACTOR=auto
# Model used by the cloud extractor
RX_VISION_MODEL=claude-opus-5-5
# Browser User-Agent for fetching FDA SrLC label-change pages (validation/fetch_srlc.py)
SRLC_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
# Reddit API client id for exploratory social listening; empty disables it
REDDIT_CLIENT_ID=
# Reddit API client secret; empty disables social listening
REDDIT_CLIENT_SECRET=
# User-Agent sent to the Reddit API
REDDIT_USER_AGENT=PharmaWatch/1.0 (research use)
